########################################
# Customer Churn Real-Time Analytics
# Environment configuration (copy to .env and edit as needed)
########################################

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=customer-events
KAFKA_CONSUMER_GROUP=churn-consumer-group

# --- Database ---
DATABASE_PATH=data/processed/churn_analytics.db

# --- Model ---
MODEL_PATH=models/churn_model.pkl
MODEL_METADATA_PATH=models/model_metadata.json

# --- Data ---
RAW_DATA_PATH=data/raw/telecom_customer_churn.csv

# --- Simulator ---
# Seconds between simulated customer events (can be fractional, e.g. 0.5)
SIMULATION_INTERVAL=1.0
# Number of distinct customers the simulator cycles through
SIMULATION_NUM_CUSTOMERS=200
# Probability [0-1] that a generated event belongs to an "increasing risk" customer
SIMULATION_RISK_PROBABILITY=0.25
# Optional cap on number of events to generate (0 = run forever)
SIMULATION_MAX_EVENTS=0

# --- Alerts ---
ALERT_HIGH_THRESHOLD=0.6
ALERT_CRITICAL_THRESHOLD=0.8
